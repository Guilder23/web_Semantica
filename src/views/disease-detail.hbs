<article>
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="bg-light p-5 text-center text-muted rounded">
        Concepto
      </div>
      
      <div class="card mb-3">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">Detalles del Concepto</h2>
        </div>
        <ul class="list-group list-group-flush">
          {{#if disease.types}}
            <li class="list-group-item">
              <strong>Tipos:</strong>
              <div class="small text-muted">
                {{#each disease.types}}
                  <div>{{this}}</div>
                {{/each}}
              </div>
            </li>
          {{/if}}
        </ul>
      </div>
    </div>
    
    <div class="col-md-8">
      <h1 class="mb-3">{{disease.name}}</h1>
      
      <div class="mb-4">
        <h2 class="h4">Descripción</h2>
        <p>{{disease.description}}</p>
      </div>

      {{#if disease.triples}}
        <div class="mb-4">
          <h2 class="h4">Triples (muestra)</h2>
          <div class="bg-light p-3 rounded" style="max-height: 260px; overflow:auto;">
            {{#each disease.triples}}
              <div class="small"><strong>{{this.p}}</strong> → {{this.o}}</div>
            {{/each}}
          </div>
        </div>
      {{/if}}
      
      <div class="d-flex justify-content-between">
        <a href="/search?q={{encodeURIComponent (split disease.name ' '.[0])}}&source={{source}}" class="btn btn-outline-secondary">
          Volver a resultados
        </a>
        <a href="{{disease.uri}}" class="btn btn-outline-primary" target="_blank" rel="noopener">
          Ver URI
        </a>
      </div>
    </div>
  </div>
</article>